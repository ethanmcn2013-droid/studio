# Public marketing routes need no environment variables. Copy this file to
# .env.local and fill only the feature groups used by the local workspace.

# Protected Signal HQ access
SIGNAL_HQ_PASSWORD=

# Studio / HQ database-backed features
STUDIO_DATABASE_URL=
STUDIO_AUTH_TOKEN=

# Shared entitlement features
ENTITLEMENTS_DATABASE_URL=
ENTITLEMENTS_AUTH_TOKEN=
