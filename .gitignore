# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/
.playwright-mcp/
.responsive-audit/

# ux-test session artifacts (screenshots + env-readiness reports, 200MB+)
/ux-tests/

# Experience Quality OS runtime evidence. Approved baselines and generated
# machine/human reports remain tracked; raw candidate/diff/test runs do not.
/experience/output/screenshots/
/experience/output/diffs/
/experience/output/playwright-report/
/experience/output/playwright-results/
/experience/output/hq-gallery/
/experience/output/handoff-playwright-report/
/experience/output/handoff-playwright-results/

# local dev scratch DB (schools UI verification)
dev-local.db*

# VEF-2026 private operating data. The template and the handling guidance are
# tracked; the live venue file and anything else dropped in here is not.
/docs/execution/venue-edition-and-films/private/*
!/docs/execution/venue-edition-and-films/private/README.md
!/docs/execution/venue-edition-and-films/private/venues.template.csv

# project-control atomic-write scratch files
/docs/execution/venue-edition-and-films/**/*.tmp

# Geocoding response cache. Regenerable, and its filenames are derived from
# venue names and addresses, so several exceed the filesystem path limit.
/docs/execution/venue-edition-and-films/.geo-cache/

# Browser-automation artifacts. Logs and screenshots from agent sessions, not
# source. Added 2026-08-03 after a wave-1 review found 1.2 MB of them staged for
# commit alongside real work.
.playwright-cli/
/output/
